#Copy this file to ".env" and fill in your values. Never commit ".env".

# Port the server listens on (Render sets this automatically)
PORT=5000

# MongoDB connection string (MongoDB Atlas free tier or local MongoDB)
# Atlas example: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/portfolio?retryWrites=true&w=majority
# Local example: mongodb://127.0.0.1:27017/portfolio
MONGODB_URI=

# Allowed frontend origins, comma separated (leave empty in development)
# Example: https://your-site.netlify.app
CLIENT_ORIGIN=